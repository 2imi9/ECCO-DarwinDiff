# Draft manuscript — kept local + in git history, not in the public default tree
/docs/paper/

# Talks: working presentation bundle (decks/scripts), never upload
/docs/talks/

# Decorative project art (rendered figures + build scaffold)
/docs/research_notes/art/

# Binary IC caches — regenerable via build_darwin_ic_cache.py; runtime-loaded
# from disk by exact name, so kept locally but never tracked
scripts/*.npz

# Repo-local gitignored working-notes home (non-core material lives here)
/notes/

# MkDocs local build output (the published site is built by Read the Docs)
/site/

# Apptainer/Singularity images + build artifacts (images are multi-GB and are
# built on the cluster; rebuild from containers/darwindiff.def)
containers/*.sif
containers/build_*.out
containers/.sif_jobid

# Local probe/diagnostic netCDF dumps written to the repo root by the UDE and
# emulator probe scripts (183 MB as of 2026-07-19). Regenerate with the probe
# scripts in scripts/; never commit.
/probe_*.nc

# Manuscript is LOCAL-ONLY by user directive (see also /docs/paper/ above).
# A root-level copy kept appearing as untracked and was one `git add .` away
# from being committed against that directive.
/main.tex
/main.pdf

# Third-party figures pulled from published papers (FNO / GINO / SFNO / CES /
# UDE-SciML) kept locally as reading references for the neural-operator scan.
# They are NOT our work and must never enter this public repo's history.
docs/figures/refs/
.claude/skills/tikz/

# Paper/abstract drafts are LOCAL-ONLY by user directive (2026-07-28).
/docs/research_notes/*workshop_paper*.md

# session-bridge runtime channel, if ever pointed inside the repo with --dir.
# The default channel lives at ~/.agent_bridge/<project>, outside the repo.
/.agent_bridge/

# Raw tensor bundles behind the findings verification JSONs. The JSONs pin each
# bundle's sha256 and the verifier tests skip when a bundle is absent, so these
# ~MB-to-56MB artifacts never enter history (main's largest tracked blob is 2.3 MB).
docs/findings/*.pt.gz

# Machine-local agent scaffolding. AGENTS.md and .claude/skills/ are the tracked
# working agreement + skills; these are per-machine mirrors/config, not sources:
# .codex/ carries a full-access sandbox config that must not ship to clones, and
# .agents/skills/ is a hand-synced Codex-side copy of .claude/skills/ (drift-prone).
/.codex/
/.agents/

# ng-loops session scaffolding, untracked on purpose per its own header.
/spec.md

# Longhurst polygon cache (fetched from the Marine Regions WFS on demand)
scripts/analysis/.province_cache/
